#!/usr/bin/env bash
set -euo pipefail

# A git hook (lefthook's pre-push) exports GIT_DIR, GIT_INDEX_FILE and friends; a test's git must
# never inherit them, or it acts on this repository instead of its fixture.
while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^GIT_' || true)

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  printf 'unformatted Go files:\n%s\n' "$unformatted" >&2
  exit 1
fi

golangci-lint run ./...
go test -race ./...
